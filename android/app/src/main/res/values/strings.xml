<?xml version="1.0" encoding="utf-8"?>
<!--
  Every user-facing string in the app, in one place — the twin of iOS's `Copy.swift`, and for
  the same two reasons: the keyboard has to say exactly what the app says, and the lines that
  came from the desktop (`src/components/EngineSettings.tsx`) are copied verbatim so the Mac
  and the phone stay one product. Anything marked *desktop* must not be reworded on its own.
-->
<resources>
    <string name="app_name">Murmur</string>

    <!-- The keyboard, as the system keyboard list and the keyboard switcher name it. -->
    <string name="ime_label">Murmur</string>

    <!-- The status strip. One line, the desktop's and iOS's words. -->
    <string name="ime_idle">Tap to speak</string>
    <string name="ime_listening">Listening…</string>
    <string name="ime_transcribing">Transcribing…</string>
    <string name="ime_needs_permission">Open Murmur to allow the microphone</string>
    <string name="ime_open_app">Open Murmur</string>
    <string name="ime_try_on_device">Try on device</string>

    <!-- The keys. No letters: Android hands the user back to their own keyboard. -->
    <string name="ime_key_globe">Next keyboard</string>
    <string name="ime_key_delete">Delete</string>
    <string name="ime_key_space">Space</string>
    <string name="ime_key_return">Return</string>
    <!-- The space bar is the one key wide enough to say what it is in words. -->
    <string name="ime_key_space_label">space</string>

    <!-- Spoken by TalkBack on the big button. -->
    <string name="ime_mic_start">Start listening</string>
    <string name="ime_mic_stop">Stop listening</string>

