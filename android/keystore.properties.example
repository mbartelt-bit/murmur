# Copy to android/keystore.properties (gitignored) and fill in.
#
# This is the *upload* key only — Play App Signing holds the key users' devices verify, so
# losing this one is recoverable and leaking it is not catastrophic. Still: keep the .jks and
# both passwords in the password manager, never in the repo.
#
# Create it once:
#   mkdir -p ~/murmur-android-signing
#   keytool -genkeypair -v -keystore ~/murmur-android-signing/murmur-upload.jks \
#     -alias murmur -keyalg RSA -keysize 2048 -validity 10000
#
# Without this file `./gradlew bundleRelease` still works — it just produces an unsigned .aab
# that Play will not accept, and prints a warning saying so.

# Absolute, or relative to the android/ directory. Keep the keystore outside the repo.
storeFile=/Users/you/murmur-android-signing/murmur-upload.jks
storePassword=
keyAlias=murmur
keyPassword=
